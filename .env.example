# ==============================================================================
# SAFE SCHOOL MAP – CỔNG TRƯỜNG AN TOÀN
# Tệp mẫu cấu hình biến môi trường (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép tệp này thành .env.local trong môi trường phát triển (hoặc thêm vào Vercel Settings).
# 2. Lấy thông tin từ Supabase Dashboard: Project Settings -> API.
# 3. Tuyệt đối KHÔNG cam kết tệp .env hoặc .env.local chứa khóa thật vào Git repository!

# 1. Khóa công khai Supabase (Được phép gửi xuống trình duyệt)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Khóa đặc quyền Server (CHỈ DÙNG PHÍA SERVER, TUYỆT ĐỐI KHÔNG CÓ TIỀN TỐ NEXT_PUBLIC_)
# Khóa này có quyền bypass RLS khi thực hiện các tác vụ quản trị nền (background workers, cron).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Cấu hình kiểm thử môi trường (Mặc định: false)
# Khi bật true trong môi trường DEV, cho phép 1 tài khoản kiểm thử mang đồng thời vai trò verifier/approver
ALLOW_DEV_MULTI_ROLE=false
